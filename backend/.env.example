# --- Deployment ------------------------------------------------------
# production | development  — in production, missing OAuth/JWT or short JWT_SECRET aborts startup.
APP_ENV=development

# --- LLM ---------------------------------------------------------------
# Provider: claude | gemini  (claude recommended for accuracy)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval / pipeline ---------------------------------------------
BATCH_SIZE=15
TOP_K=8
RETRIEVE_TOP_N=50
TIER1_SIM_THRESHOLD=0.65

# --- Concurrency ------------------------------------------------------
LLM_CONCURRENCY=4

# --- OAuth / JWT (recommended for cloud) -----------------------------
# Auth is ENABLED when BOTH are set (Google Identity Services credential flow).
GOOGLE_OAUTH_CLIENT_ID=
# Generate a random secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRE_DAYS=1
# Largest Excel upload FastAPI accepts (multipart body), in bytes (~50 MiB default).
MAX_UPLOAD_BYTES=52428800
#
# GCP console: OAuth client type "Web" — Authorized JavaScript origins must
# include your frontend origins (http://localhost:3000 AND your prod domain).
# This is separate from GOOGLE_API_KEY above (Gemini only).

# --- Persistence ------------------------------------------------------
# For Neon / Postgres: run once after setting DATABASE_URL (from repo root):
#   python -m alembic -c backend/alembic.ini upgrade head
# Or from Docker after keys are loaded:
#   docker compose run --rm backend python -m alembic -c backend/alembic.ini upgrade head
# Optional: set AUTO_MIGRATE=1 so the API runs migrations on startup (Postgres only).
AUTO_MIGRATE=0
# Pooled (serverless-friendly): postgresql+psycopg2://user:pwd@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Queue (Upstash Redis) — Phase B provisioning; RQ/Celery wiring is optional ---
REDIS_URL=
# Example: rediss://default:...@enough-glider-12345.upstash.io:6379

# --- Object storage (Cloudflare R2) — optional; uploads remain on VM disk until wired ---
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=customsai-uploads
# R2_PUBLIC_BASE_URL=

# --- Observability ------------------------------------------------------
SENTRY_DSN=
# 0.0 = errors only; raise for traces in production sparingly
SENTRY_TRACES_SAMPLE_RATE=0

# --- HTTP -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Deprecated note ---------------------------------------------------
# Leaving GOOGLE_OAUTH_CLIENT_ID AND JWT_SECRET empty keeps the API open locally.
